{
  "name": "family-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn a short text description of a family into a styled, printable family-tree poster, with the whole tree encoded in the URL.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "acceptance": "node scripts/acceptance.mjs"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.3",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.0",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
